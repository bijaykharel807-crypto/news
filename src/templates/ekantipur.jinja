    <!-- ================= 10. CLIENT UTILITY SCRIPTS ================= -->
    <script>
      // Active tab highlighting
      function setActiveTab(button) {
        document.querySelectorAll('.category-tab').forEach(tab => {
          tab.classList.remove('bg-red-900', 'text-white', 'active-tab');
          tab.classList.add('text-white/90');
        });
        button.classList.add('bg-red-900', 'text-white', 'active-tab');
        button.classList.remove('text-white/90');
      }

      // Dark Mode Toggle
      function toggleDarkMode() {
        document.documentElement.classList.toggle('dark');
        const isDark = document.documentElement.classList.contains('dark');
        localStorage.setItem('ekantipur_theme', isDark ? 'dark' : 'light');
      }

      // Initial theme check
      if (localStorage.getItem('ekantipur_theme') === 'dark' || 
          (!localStorage.getItem('ekantipur_theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }

      // Radio Bar controls
      let isRadioPlaying = false;
      function toggleRadioPlayer() {
        const bar = document.getElementById('radio-bar');
        bar.classList.toggle('translate-y-full');
      }
      function closeRadioPlayer() {
        document.getElementById('radio-bar').classList.add('translate-y-full');
        pauseRadio();
      }
      function playRadio() {
        const audio = document.getElementById('radio-audio-element');
        const btnText = document.getElementById('radio-btn-text');
        if (!isRadioPlaying) {
          audio.play().catch(e => console.log('Audio autoplay policy:', e));
          isRadioPlaying = true;
          btnText.innerText = 'रोक्नुहोस् (Pause)';
        } else {
          pauseRadio();
        }
      }
      function pauseRadio() {
        const audio = document.getElementById('radio-audio-element');
        const btnText = document.getElementById('radio-btn-text');
        audio.pause();
        isRadioPlaying = false;
        btnText.innerText = 'बजाउनुहोस् (Play)';
      }

      // Article Audio Reader using Web Speech Synthesis API
      let isSpeaking = false;
      function playArticleAudio(text) {
        if ('speechSynthesis' in window) {
          if (isSpeaking) {
            window.speechSynthesis.cancel();
            isSpeaking = false;
            document.getElementById('tts-label').innerText = 'समाचार सुन्नुहोस्';
            return;
          }
          const utterance = new SpeechSynthesisUtterance(text);
          utterance.lang = 'ne-NP';
          utterance.rate = 0.95;
          utterance.onend = () => {
            isSpeaking = false;
            document.getElementById('tts-label').innerText = 'समाचार सुन्नुहोस्';
          };
          utterance.onerror = () => {
            isSpeaking = false;
            document.getElementById('tts-label').innerText = 'समाचार सुन्नुहोस्';
          };
          window.speechSynthesis.speak(utterance);
          isSpeaking = true;
          document.getElementById('tts-label').innerText = 'रोक्नुहोस् (Stop)';
        } else {
          alert('तपाईँको ब्राउजरमा अडियो वाचन सुविधा उपलब्ध छैन।');
        }
      }

      // Social share simulation
      function shareArticle(platform, title) {
        const url = encodeURIComponent(window.location.href);
        const text = encodeURIComponent(title);
        let shareUrl = '';
        if (platform === 'facebook') shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${url}`;
        if (platform === 'twitter') shareUrl = `https://twitter.com/intent/tweet?text=${text}&url=${url}`;
        if (platform === 'whatsapp') shareUrl = `https://api.whatsapp.com/send?text=${text}%20${url}`;
        if (shareUrl) window.open(shareUrl, '_blank', 'width=600,height=400');
      }

      function copyArticleLink() {
        navigator.clipboard.writeText(window.location.href).then(() => {
          showToast('समाचारको लिंक कपी भयो!');
        });
      }

      function showToast(msg) {
        const toast = document.getElementById('toast');
        toast.innerText = msg;
        toast.classList.remove('translate-y-20', 'opacity-0');
        setTimeout(() => {
          toast.classList.add('translate-y-20', 'opacity-0');
        }, 2500);
      }

      // Template Inspector Modal
      function openTemplateInspector() {
        document.getElementById('template-inspector-modal').classList.remove('hidden');
      }
      function closeTemplateInspector() {
        document.getElementById('template-inspector-modal').classList.add('hidden');
      }
    </script>

