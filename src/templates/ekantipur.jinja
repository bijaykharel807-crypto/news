{# =====================================================================
   eKantipur.com - Complete Portal in ONE Jinja Template File
   Tech Stack: HTMX + Single Jinja Template + Tailwind CSS
   Features:
   - Dynamic Category Switching via HTMX (hx-get / hx-target)
   - Infinite / Load More News Feed (hx-get / hx-swap="beforeend")
   - Auto-updating Breaking News Ticker (hx-get / hx-trigger="every 10s")
   - Live Instant Search with Debounced Trigger (hx-trigger="keyup changed delay:300ms")
   - In-page Full Article Reader Modal (hx-get)
   - Interactive Public Opinion Poll (hx-post / hx-swap="outerHTML")
   - Live Radio Kantipur 96.1 FM Player with Audio Controls
   - Stock Market (NEPSE), Gold/Silver & Forex Exchange Rate Widgets
   - Nepali Bikram Sambat (BS) & Gregorian Calendar
   - Dark / Light Theme & Font Size Zoom
   ===================================================================== #}

{% if fragment == 'news_feed' %}
  {# ================= PARTIAL: News Grid Feed (for Category filter & Load More) ================= #}
  {% for item in articles %}
    <article class="news-card bg-white dark:bg-neutral-900 rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-800 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
      <div>
        <div class="relative overflow-hidden aspect-[16/10] bg-neutral-100 dark:bg-neutral-800">
          <img 
            src="{{ item.image }}" 
            alt="{{ item.title }}"
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            referrerpolicy="no-referrer"
          />
          <span class="absolute top-3 left-3 bg-red-600/90 text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-sm backdrop-blur-xs">
            {{ item.category }}
          </span>
          {% if item.is_breaking %}
            <span class="absolute top-3 right-3 bg-amber-500 text-neutral-950 text-xs font-bold px-2 py-0.5 rounded shadow flex items-center gap-1 animate-pulse">
              <span class="w-2 h-2 rounded-full bg-neutral-950"></span> ताजा
            </span>
          {% endif %}
        </div>
        <div class="p-5">
          <div class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400 mb-2">
            <span>{{ item.time_ago }}</span>
            <span>•</span>
            <span class="flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
              {{ item.author }}
            </span>
            <span>•</span>
            <span>{{ item.location }}</span>
          </div>
          <h3 
            class="text-lg md:text-xl font-bold font-serif text-neutral-900 dark:text-neutral-100 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors leading-snug cursor-pointer line-clamp-2"
            hx-get="/api/article/{{ item.id }}"
            hx-target="#modal-container"
            hx-swap="innerHTML"
          >
            {{ item.title }}
          </h3>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300 line-clamp-2 leading-relaxed font-sans">
            {{ item.summary }}
          </p>
        </div>
      </div>
      <div class="px-5 pb-5 pt-2 border-t border-neutral-100 dark:border-neutral-800/60 flex items-center justify-between text-xs text-neutral-500">
        <span class="flex items-center gap-1.5 hover:text-neutral-700 dark:hover:text-neutral-300">
          <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
          {{ item.views }} पटक हेरिएको
        </span>
        <button 
          class="text-red-600 dark:text-red-400 hover:text-red-700 font-semibold flex items-center gap-1 group/btn"
          hx-get="/api/article/{{ item.id }}"
          hx-target="#modal-container"
          hx-swap="innerHTML"
        >
          पूरा पढ्नुहोस् 
          <span class="group-hover/btn:translate-x-0.5 transition-transform">→</span>
        </button>
      </div>
    </article>
  {% endfor %}

  {% if next_page %}
    <div id="load-more-container" class="col-span-full text-center py-6">
      <button 
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 font-semibold text-sm hover:bg-red-600 dark:hover:bg-red-500 dark:hover:text-white transition-all shadow-sm active:scale-95"
        hx-get="/api/news?page={{ next_page }}&category={{ current_category }}"
        hx-target="#load-more-container"
        hx-swap="outerHTML"
      >
        <span class="htmx-indicator hidden">
          <svg class="animate-spin w-4 h-4 text-current" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
        </span>
        थप समाचार लोड गर्नुहोस् (थप {{ remaining_count }} वटा)
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </button>
    </div>
  {% else %}
    <div class="col-span-full text-center py-8 text-neutral-400 text-sm">
      ✓ यस खण्डका सबै समाचार लोड भइसकेका छन् ।
    </div>
  {% endif %}

{% elif fragment == 'ticker' %}
  {# ================= PARTIAL: Breaking Ticker (Auto refreshed by HTMX every 10s) ================= #}
  <div class="flex items-center gap-3 overflow-hidden text-sm">
    <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider bg-red-600 text-white px-2.5 py-1 rounded shadow-sm shrink-0">
      <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
      ताजा अपडेट
    </span>
    <span class="text-neutral-400 text-xs shrink-0">{{ current_breaking.time }}</span>
    <span 
      class="font-medium text-neutral-800 dark:text-neutral-100 hover:text-red-600 dark:hover:text-red-400 transition-colors cursor-pointer truncate"
      hx-get="/api/article/{{ current_breaking.id }}"
      hx-target="#modal-container"
      hx-swap="innerHTML"
    >
      {{ current_breaking.title }}
    </span>
  </div>

{% elif fragment == 'search_results' %}
  {# ================= PARTIAL: Search Results Dropdown ================= #}
  {% if results.length > 0 %}
    <div class="p-3 bg-white dark:bg-neutral-900 rounded-xl shadow-2xl border border-neutral-200 dark:border-neutral-800 max-h-96 overflow-y-auto">
      <div class="text-xs font-semibold text-neutral-400 px-3 py-1 uppercase tracking-wider">
        भेटिएका नतिजा ({{ results.length }})
      </div>
      <div class="divide-y divide-neutral-100 dark:divide-neutral-800">
        {% for item in results %}
          <div 
            class="p-3 hover:bg-neutral-50 dark:hover:bg-neutral-800/60 rounded-lg cursor-pointer transition-colors flex gap-3 items-center"
            hx-get="/api/article/{{ item.id }}"
            hx-target="#modal-container"
            hx-swap="innerHTML"
            onclick="document.getElementById('search-dropdown').classList.add('hidden')"
          >
            <img src="{{ item.image }}" alt="" class="w-16 h-12 object-cover rounded shrink-0 bg-neutral-200" referrerpolicy="no-referrer">
            <div class="min-w-0">
              <span class="text-[10px] text-red-600 font-bold uppercase tracking-wider">{{ item.category }}</span>
              <h4 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 truncate hover:text-red-600">{{ item.title }}</h4>
              <p class="text-xs text-neutral-500 truncate">{{ item.time_ago }} • {{ item.author }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="p-5 text-center text-sm text-neutral-500 bg-white dark:bg-neutral-900 rounded-xl shadow-xl border border-neutral-200 dark:border-neutral-800">
      "{{ query }}" सँग मिल्दोजुल्दो कुनै समाचार भेटिएन ।
    </div>
  {% endif %}

{% elif fragment == 'poll_result' %}
  {# ================= PARTIAL: Interactive Poll (Outer-Swapped on Vote) ================= #}
  <div id="kantipur-poll" class="bg-gradient-to-br from-neutral-50 to-neutral-100 dark:from-neutral-900 dark:to-neutral-850 p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <span class="text-xs font-bold uppercase tracking-wider text-red-600 bg-red-50 dark:bg-red-950/50 px-2.5 py-1 rounded-md border border-red-200 dark:border-red-900/50">
        📊 कान्तिपुर जनमत
      </span>
      <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1">
        ✓ तपाईँको मत सुरक्षित भयो!
      </span>
    </div>
    <h3 class="text-base font-bold text-neutral-900 dark:text-neutral-100 mb-5 font-serif leading-snug">
      {{ poll.question }}
    </h3>
    
    <div class="space-y-3.5">
      {% for opt in poll.options %}
        <div>
          <div class="flex justify-between text-xs font-semibold mb-1 text-neutral-700 dark:text-neutral-300">
            <span>{{ opt.text }}</span>
            <span>{{ opt.percentage }}% ({{ opt.votes }} मत)</span>
          </div>
          <div class="w-full bg-neutral-200 dark:bg-neutral-700 h-2.5 rounded-full overflow-hidden">
            <div 
              class="h-full rounded-full transition-all duration-700 {% if loop.index == 1 %}bg-red-600{% elif loop.index == 2 %}bg-blue-600{% else %}bg-neutral-500{% endif %}"
              style="width: {{ opt.percentage }}%"
            ></div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="mt-5 pt-4 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between text-xs text-neutral-500">
      <span>कुल संकलित मत: <strong>{{ poll.total_votes }}</strong></span>
      <span>अद्यावधिक: भर्खरै</span>
    </div>
  </div>

{% elif fragment == 'article_modal' %}
  {# ================= PARTIAL: Reader Modal ================= #}
  <div id="article-reader-backdrop" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/75 backdrop-blur-sm overflow-y-auto animate-fadeIn">
    <div class="relative w-full max-w-3xl bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 rounded-2xl shadow-2xl border border-neutral-200 dark:border-neutral-800 overflow-hidden my-8 max-h-[90vh] flex flex-col">
      
      <!-- Modal Top Bar -->
      <div class="px-6 py-4 bg-neutral-50 dark:bg-neutral-850 border-b border-neutral-200 dark:border-neutral-800 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2">
          <span class="bg-red-600 text-white text-xs font-bold px-2.5 py-0.5 rounded uppercase">
            {{ article.category }}
          </span>
          <span class="text-xs text-neutral-500">{{ article.date_bs }} ({{ article.time_ago }})</span>
        </div>
        <div class="flex items-center gap-2">
          <button 
            type="button"
            onclick="playArticleAudio('{{ article.title }} {{ article.summary }}')"
            id="tts-button"
            title="समाचार सुन्नुहोस्"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-neutral-200 dark:bg-neutral-700 text-xs font-semibold hover:bg-red-600 hover:text-white transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>
            <span id="tts-label">समाचार सुन्नुहोस्</span>
          </button>
          <button 
            type="button"
            onclick="document.getElementById('article-reader-backdrop').remove()"
            class="w-8 h-8 rounded-full bg-neutral-200 dark:bg-neutral-800 hover:bg-red-600 hover:text-white flex items-center justify-center transition-colors text-neutral-600 dark:text-neutral-300"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Modal Body (Scrollable) -->
      <div class="p-6 md:p-8 overflow-y-auto space-y-6">
        <h1 class="text-2xl md:text-3xl lg:text-4xl font-extrabold font-serif leading-tight text-neutral-900 dark:text-neutral-50">
          {{ article.title }}
        </h1>

        <div class="flex flex-wrap items-center justify-between gap-4 py-3 border-y border-neutral-100 dark:border-neutral-800 text-xs text-neutral-500 dark:text-neutral-400">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-red-100 dark:bg-red-900/30 text-red-600 font-bold flex items-center justify-center text-sm">
              का
            </div>
            <div>
              <div class="font-bold text-neutral-800 dark:text-neutral-200">{{ article.author }}</div>
              <div>{{ article.location }}, नेपाल</div>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <span>{{ article.read_time }} मिनेट पढाइ</span>
            <span>•</span>
            <span>{{ article.views }} अवलोकन</span>
          </div>
        </div>

        <!-- Featured Media -->
        <div class="rounded-xl overflow-hidden shadow-md bg-neutral-100 dark:bg-neutral-800">
          <img 
            src="{{ article.image }}" 
            alt="{{ article.title }}" 
            class="w-full max-h-[420px] object-cover"
            referrerpolicy="no-referrer"
          />
          <div class="p-3 bg-neutral-50 dark:bg-neutral-850 text-xs text-neutral-500 italic">
            तस्बिर: कान्तिपुर दैनिक फोटो लाइब्रेरी ।
          </div>
        </div>

        <!-- Lead Paragraph -->
        <div class="text-lg md:text-xl font-medium text-neutral-800 dark:text-neutral-200 font-serif leading-relaxed border-l-4 border-red-600 pl-4 py-1">
          {{ article.summary }}
        </div>

        <!-- Article Content -->
        <div class="prose dark:prose-invert max-w-none font-sans text-neutral-700 dark:text-neutral-300 leading-relaxed text-base space-y-4">
          {% for paragraph in article.paragraphs %}
            <p>{{ paragraph }}</p>
          {% endfor %}
        </div>

        <!-- Tags -->
        <div class="pt-6 border-t border-neutral-100 dark:border-neutral-800 flex flex-wrap gap-2 items-center">
          <span class="text-xs font-bold text-neutral-400">सम्बन्धित विषय:</span>
          {% for tag in article.tags %}
            <span class="text-xs px-3 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:bg-red-50 hover:text-red-600 cursor-pointer transition-colors">
              #{{ tag }}
            </span>
          {% endfor %}
        </div>

        <!-- Social Share Bar -->
        <div class="p-4 bg-neutral-50 dark:bg-neutral-850 rounded-xl flex items-center justify-between">
          <span class="text-xs font-semibold text-neutral-500">समाचार सेयर गर्नुहोस्:</span>
          <div class="flex gap-2">
            <button onclick="shareArticle('facebook', '{{ article.title }}')" class="px-3 py-1 rounded bg-[#1877F2] text-white text-xs font-semibold hover:opacity-90">Facebook</button>
            <button onclick="shareArticle('twitter', '{{ article.title }}')" class="px-3 py-1 rounded bg-black text-white text-xs font-semibold hover:opacity-90">X (Twitter)</button>
            <button onclick="shareArticle('whatsapp', '{{ article.title }}')" class="px-3 py-1 rounded bg-[#25D366] text-white text-xs font-semibold hover:opacity-90">WhatsApp</button>
            <button onclick="copyArticleLink()" class="px-3 py-1 rounded bg-neutral-200 dark:bg-neutral-700 text-neutral-800 dark:text-neutral-200 text-xs font-semibold hover:opacity-90">लिंक कपी</button>
          </div>
        </div>

      </div>
    </div>
  </div>

{% else %}
  {# =====================================================================
     FULL PAGE HTML SHELL
     When loaded normally or refreshed, this complete template renders.
     ===================================================================== #}
  <!DOCTYPE html>
  <html lang="ne" class="scroll-smooth">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>eKantipur - कान्तिपुर | नेपालको राष्ट्रिय दैनिक</title>
    <meta name="description" content="नेपालको नम्बर १ समाचार पोर्टल - कान्तिपुर दैनिक। राजनीति, समाज, अर्थ, खेलकुद, विचार, मनोरञ्जन र विश्व समाचारको विश्वसनीय स्रोत।">
    
    <!-- Google Fonts: Mukta & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Mukta:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', '"Mukta"', 'system-ui', 'sans-serif'],
              serif: ['"Mukta"', 'Georgia', 'serif']
            },
            colors: {
              brand: {
                50: '#fef2f2',
                100: '#fee2e2',
                500: '#ef4444',
                600: '#dc2626',
                700: '#b91c1c',
                800: '#991b1b',
                900: '#7f1d1d'
              }
            }
          }
        }
      }
    </script>
    
    <!-- HTMX Script -->
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    
    <style>
      .htmx-indicator { display: none; }
      .htmx-request .htmx-indicator { display: inline-flex; }
      .htmx-request.htmx-indicator { display: inline-flex; }
      
      @keyframes fadeIn {
        from { opacity: 0; transform: scale(0.98); }
        to { opacity: 1; transform: scale(1); }
      }
      .animate-fadeIn { animation: fadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    </style>
  </head>
  
  <body class="bg-neutral-100 dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 antialiased min-h-screen flex flex-col font-sans transition-colors duration-200">
    
    <!-- Modal Injection Target Container for HTMX -->
    <div id="modal-container"></div>

    <!-- Notification Toast Target -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none bg-neutral-900 dark:bg-white text-white dark:text-neutral-950 px-4 py-2.5 rounded-lg shadow-xl text-xs font-semibold">
      लिंक कपी भयो!
    </div>

    <!-- ================= 1. SUPER TOP UTILITY BAR ================= -->
    <header class="bg-white dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800 text-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2 flex flex-wrap items-center justify-between gap-3">
        
        <!-- Left: Date & Weather -->
        <div class="flex items-center gap-4 text-neutral-600 dark:text-neutral-400">
          <div class="flex items-center gap-1.5 font-medium">
            <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span class="text-neutral-900 dark:text-neutral-200 font-semibold">{{ nepali_date }}</span>
            <span class="text-neutral-400">({{ english_date }})</span>
          </div>
          
          <div class="hidden md:flex items-center gap-1.5 text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-800 px-2.5 py-1 rounded-md">
            <span>⛅ {{ weather.city }}</span>
            <span class="font-bold text-neutral-900 dark:text-neutral-100">{{ weather.temp }}</span>
            <span class="text-neutral-400 text-[11px]">{{ weather.condition }}</span>
          </div>

          <div class="hidden lg:flex items-center gap-1.5 text-neutral-500">
            <span>📈 नेप्से:</span>
            <span class="font-semibold text-emerald-600">२,४१२.४० (+१२.३०)</span>
          </div>
        </div>

        <!-- Right: Utility Links & Controls -->
        <div class="flex items-center gap-3">
          
          <!-- Radio Kantipur FM Player Button -->
          <button 
            type="button" 
            onclick="toggleRadioPlayer()"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-red-50 dark:bg-red-950/40 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-900/40 font-semibold hover:bg-red-600 hover:text-white transition-all shadow-xs"
          >
            <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse" id="radio-indicator"></span>
            <span>रेडियो कान्तिपुर ९६.१</span>
          </button>

          <!-- E-paper Link -->
          <a href="#epaper" class="hover:text-red-600 transition-colors font-medium hidden sm:inline-block">
            ई-कागज (ePaper)
          </a>

          <span class="text-neutral-300 dark:text-neutral-700">|</span>

          <!-- English Edition Switcher -->
          <a href="https://kathmandupost.com" target="_blank" class="hover:text-red-600 transition-colors font-medium">
            English (The Kathmandu Post)
          </a>

          <span class="text-neutral-300 dark:text-neutral-700">|</span>

          <!-- Dark Mode Toggle -->
          <button 
            type="button" 
            onclick="toggleDarkMode()" 
            class="p-1.5 rounded-md hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-300 transition-colors"
            title="डार्क मोड टगल"
          >
            <svg id="theme-icon-dark" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            <svg id="theme-icon-light" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
          </button>
        </div>

      </div>
    </header>

    <!-- ================= 2. MAIN BRAND MASTHEAD ================= -->
    <div class="bg-white dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 flex flex-col md:flex-row items-center justify-between gap-6">
        
        <!-- Left: Logo & Slogan -->
        <div class="flex flex-col items-center md:items-start text-center md:text-left">
          <a href="/" class="flex items-center gap-3 group">
            <div class="w-11 h-11 rounded-xl bg-red-600 text-white font-serif font-black text-2xl flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
              का
            </div>
            <div>
              <span class="text-3xl md:text-4xl font-extrabold font-serif tracking-tight text-neutral-900 dark:text-white group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors">
                कान्तिपुर
              </span>
              <span class="text-red-600 font-extrabold text-3xl">.</span>
            </div>
          </a>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 font-medium">
            नेपालको नम्बर १ समाचार पोर्टल • Kantipur Media Group
          </p>
        </div>

        <!-- Center / Right: Live Interactive Search with HTMX -->
        <div class="relative w-full max-w-md">
          <div class="relative">
            <input 
              type="text" 
              name="q"
              placeholder="समाचार, विचार वा लेखक खोज्नुहोस्..."
              class="w-full bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-neutral-900 dark:text-neutral-100 text-sm rounded-full pl-10 pr-10 py-2.5 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all placeholder:text-neutral-400"
              hx-get="/api/search"
              hx-trigger="keyup changed delay:300ms, search"
              hx-target="#search-results"
              hx-swap="innerHTML"
              hx-indicator="#search-spinner"
              onfocus="document.getElementById('search-dropdown').classList.remove('hidden')"
            />
            <div class="absolute left-3.5 top-3 text-neutral-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <div id="search-spinner" class="htmx-indicator absolute right-3.5 top-3">
              <svg class="animate-spin w-4 h-4 text-red-600" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
            </div>
          </div>

          <!-- Dropdown search target -->
          <div id="search-dropdown" class="hidden absolute top-full mt-2 left-0 right-0 z-40">
            <div id="search-results"></div>
          </div>
        </div>

        <!-- Source Code / Single Template Inspector Modal Trigger -->
        <div class="flex items-center gap-2">
          <button 
            type="button" 
            onclick="openTemplateInspector()"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-xs font-bold hover:bg-red-600 dark:hover:bg-red-500 dark:hover:text-white transition-all shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
            <span>Single Jinja Template & Python Code</span>
          </button>
        </div>

      </div>
    </div>

    <!-- ================= 3. PRIMARY NAVIGATION BAR (HTMX Category Tabs) ================= -->
    <nav class="sticky top-0 z-30 bg-red-700 text-white shadow-md border-b border-red-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between overflow-x-auto no-scrollbar py-1">
          <div class="flex items-center space-x-1 sm:space-x-2 text-sm font-semibold shrink-0" id="category-tabs">
            
            {% for cat in categories %}
              <button 
                type="button"
                hx-get="/api/category/{{ cat.id }}"
                hx-target="#main-news-container"
                hx-swap="innerHTML"
                hx-indicator="#nav-indicator"
                onclick="setActiveTab(this)"
                class="category-tab px-3 py-2 rounded-md transition-colors text-white/90 hover:text-white hover:bg-red-800/80 whitespace-nowrap {% if loop.first %}bg-red-900 text-white active-tab{% endif %}"
                data-category="{{ cat.id }}"
              >
                {{ cat.name }}
              </button>
            {% endfor %}

          </div>
          
          <div id="nav-indicator" class="htmx-indicator ml-3 shrink-0">
            <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
          </div>
        </div>
      </div>
    </nav>

    <!-- ================= 4. BREAKING NEWS LIVE TICKER (HTMX Polled every 10s) ================= -->
    <div class="bg-neutral-50 dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2.5">
        <div 
          id="breaking-ticker"
          hx-get="/api/ticker"
          hx-trigger="every 10s"
          hx-swap="innerHTML"
        >
          <!-- Initial ticker content -->
          <div class="flex items-center gap-3 overflow-hidden text-sm">
            <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider bg-red-600 text-white px-2.5 py-1 rounded shadow-sm shrink-0">
              <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
              ताजा अपडेट
            </span>
            <span class="text-neutral-400 text-xs shrink-0">{{ current_breaking.time }}</span>
            <span 
              class="font-medium text-neutral-800 dark:text-neutral-100 hover:text-red-600 dark:hover:text-red-400 transition-colors cursor-pointer truncate"
              hx-get="/api/article/{{ current_breaking.id }}"
              hx-target="#modal-container"
              hx-swap="innerHTML"
            >
              {{ current_breaking.title }}
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= 5. MAIN CONTENT WRAPPER ================= -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8 flex-1 w-full space-y-10">

      <!-- Dynamic Category Container (Swapped by HTMX on Category Tab Click) -->
      <div id="main-news-container" class="space-y-10">
        
        <!-- Top Lead Hero Section -->
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Big Lead Story (Col 1 to 8) -->
          <article class="lg:col-span-8 bg-white dark:bg-neutral-900 rounded-2xl overflow-hidden border border-neutral-200 dark:border-neutral-800 shadow-sm group">
            <div class="relative overflow-hidden aspect-[16/9] bg-neutral-100 dark:bg-neutral-800">
              <img 
                src="{{ lead_story.image }}" 
                alt="{{ lead_story.title }}" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                referrerpolicy="no-referrer"
              />
              <span class="absolute top-4 left-4 bg-red-600 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-md uppercase tracking-wider">
                {{ lead_story.category }}
              </span>
              <span class="absolute bottom-4 left-4 right-4 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-4 rounded-xl text-white text-xs hidden sm:block">
                {{ lead_story.time_ago }} • {{ lead_story.author }} ({{ lead_story.location }})
              </span>
            </div>
            
            <div class="p-6 md:p-8 space-y-4">
              <h1 
                class="text-2xl md:text-3xl lg:text-4xl font-extrabold font-serif text-neutral-900 dark:text-neutral-50 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors cursor-pointer leading-tight"
                hx-get="/api/article/{{ lead_story.id }}"
                hx-target="#modal-container"
                hx-swap="innerHTML"
              >
                {{ lead_story.title }}
              </h1>
              
              <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 font-sans leading-relaxed">
                {{ lead_story.summary }}
              </p>
              
              <div class="pt-4 border-t border-neutral-100 dark:border-neutral-800 flex items-center justify-between text-xs text-neutral-500">
                <span class="font-medium">कान्तिपुर विशेष कभरेज</span>
                <button 
                  class="text-red-600 dark:text-red-400 font-bold hover:underline inline-flex items-center gap-1"
                  hx-get="/api/article/{{ lead_story.id }}"
                  hx-target="#modal-container"
                  hx-swap="innerHTML"
                >
                  विस्तृत समाचार पढ्नुहोस् →
                </button>
              </div>
            </div>
          </article>

          <!-- Right Sidebar: Hot Topics & Trending List (Col 9 to 12) -->
          <div class="lg:col-span-4 space-y-6">
            
            <!-- Trending Today Box -->
            <div class="bg-white dark:bg-neutral-900 p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm">
              <div class="flex items-center justify-between pb-4 mb-4 border-b border-neutral-100 dark:border-neutral-800">
                <h3 class="font-serif font-bold text-lg text-neutral-900 dark:text-white flex items-center gap-2">
                  <span class="text-red-600">🔥</span> धेरै पढिएका (Trending)
                </h3>
                <span class="text-[11px] font-semibold text-neutral-400 bg-neutral-100 dark:bg-neutral-800 px-2 py-0.5 rounded">२४ घण्टा</span>
              </div>
              
              <div class="space-y-4 divide-y divide-neutral-100 dark:divide-neutral-800">
                {% for item in trending_stories %}
                  <div class="pt-3.5 first:pt-0 flex gap-4 items-start group cursor-pointer"
                       hx-get="/api/article/{{ item.id }}"
                       hx-target="#modal-container"
                       hx-swap="innerHTML">
                    <span class="font-serif font-black text-2xl text-red-600/40 group-hover:text-red-600 transition-colors w-6 shrink-0">
                      {{ loop.index }}
                    </span>
                    <div class="min-w-0">
                      <span class="text-[10px] text-red-600 font-bold uppercase tracking-wider">{{ item.category }}</span>
                      <h4 class="text-sm font-bold font-serif text-neutral-800 dark:text-neutral-200 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors line-clamp-2 leading-snug">
                        {{ item.title }}
                      </h4>
                      <p class="text-[11px] text-neutral-400 mt-1">{{ item.time_ago }} • {{ item.views }} पटक हेरिएको</p>
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>

            <!-- Opinion & Editorial Highlight -->
            <div class="bg-gradient-to-br from-amber-50 to-orange-50/40 dark:from-neutral-900 dark:to-neutral-850 p-6 rounded-2xl border border-amber-200/60 dark:border-neutral-800 shadow-sm">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-400 bg-amber-100 dark:bg-amber-950/60 px-2.5 py-1 rounded-md">
                  ✍️ विचार र दृष्टिकोण
                </span>
                <span class="text-xs text-neutral-500">सम्पादकीय</span>
              </div>
              <h4 
                class="text-base font-bold font-serif text-neutral-900 dark:text-neutral-100 hover:text-red-600 cursor-pointer transition-colors leading-snug"
                hx-get="/api/article/{{ editorial_story.id }}"
                hx-target="#modal-container"
                hx-swap="innerHTML"
              >
                {{ editorial_story.title }}
              </h4>
              <p class="text-xs text-neutral-600 dark:text-neutral-300 mt-2 line-clamp-3">
                {{ editorial_story.summary }}
              </p>
              <div class="mt-4 pt-3 border-t border-amber-200/50 dark:border-neutral-800 text-xs font-semibold text-neutral-700 dark:text-neutral-300 flex items-center justify-between">
                <span>{{ editorial_story.author }}</span>
                <span class="text-red-600 cursor-pointer hover:underline"
                      hx-get="/api/article/{{ editorial_story.id }}"
                      hx-target="#modal-container"
                      hx-swap="innerHTML">पढ्नुहोस् →</span>
              </div>
            </div>

          </div>

        </section>

        <!-- Secondary News Grid (HTMX Infinite Load Target) -->
        <section class="space-y-6">
          <div class="flex items-center justify-between border-b-2 border-red-600 pb-3">
            <h2 class="text-xl md:text-2xl font-bold font-serif text-neutral-900 dark:text-neutral-100 flex items-center gap-2">
              <span class="w-3 h-3 bg-red-600 rounded-sm"></span>
              ताजा समाचार र विश्लेषण
            </h2>
            <div class="text-xs text-neutral-500 font-medium">
              HTMX Dynamic Feed
            </div>
          </div>

          <!-- The dynamic news grid -->
          <div id="news-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for item in articles %}
              <article class="news-card bg-white dark:bg-neutral-900 rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-800 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
                <div>
                  <div class="relative overflow-hidden aspect-[16/10] bg-neutral-100 dark:bg-neutral-800">
                    <img 
                      src="{{ item.image }}" 
                      alt="{{ item.title }}"
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      referrerpolicy="no-referrer"
                    />
                    <span class="absolute top-3 left-3 bg-red-600/90 text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-sm backdrop-blur-xs">
                      {{ item.category }}
                    </span>
                    {% if item.is_breaking %}
                      <span class="absolute top-3 right-3 bg-amber-500 text-neutral-950 text-xs font-bold px-2 py-0.5 rounded shadow flex items-center gap-1 animate-pulse">
                        <span class="w-2 h-2 rounded-full bg-neutral-950"></span> ताजा
                      </span>
                    {% endif %}
                  </div>
                  <div class="p-5">
                    <div class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400 mb-2">
                      <span>{{ item.time_ago }}</span>
                      <span>•</span>
                      <span>{{ item.author }}</span>
                      <span>•</span>
                      <span>{{ item.location }}</span>
                    </div>
                    <h3 
                      class="text-lg md:text-xl font-bold font-serif text-neutral-900 dark:text-neutral-100 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors leading-snug cursor-pointer line-clamp-2"
                      hx-get="/api/article/{{ item.id }}"
                      hx-target="#modal-container"
                      hx-swap="innerHTML"
                    >
                      {{ item.title }}
                    </h3>
                    <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300 line-clamp-2 leading-relaxed font-sans">
                      {{ item.summary }}
                    </p>
                  </div>
                </div>
                <div class="px-5 pb-5 pt-2 border-t border-neutral-100 dark:border-neutral-800/60 flex items-center justify-between text-xs text-neutral-500">
                  <span class="flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                    {{ item.views }} पटक हेरिएको
                  </span>
                  <button 
                    class="text-red-600 dark:text-red-400 hover:text-red-700 font-semibold flex items-center gap-1 group/btn"
                    hx-get="/api/article/{{ item.id }}"
                    hx-target="#modal-container"
                    hx-swap="innerHTML"
                  >
                    पूरा पढ्नुहोस् 
                    <span class="group-hover/btn:translate-x-0.5 transition-transform">→</span>
                  </button>
                </div>
              </article>
            {% endfor %}

            <!-- HTMX Load More Button Trigger -->
            {% if next_page %}
              <div id="load-more-container" class="col-span-full text-center py-6">
                <button 
                  class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 font-semibold text-sm hover:bg-red-600 dark:hover:bg-red-500 dark:hover:text-white transition-all shadow-sm active:scale-95"
                  hx-get="/api/news?page={{ next_page }}&category={{ current_category }}"
                  hx-target="#load-more-container"
                  hx-swap="outerHTML"
                >
                  <span class="htmx-indicator hidden">
                    <svg class="animate-spin w-4 h-4 text-current" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                  </span>
                  थप समाचार लोड गर्नुहोस् (थप {{ remaining_count }} वटा)
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>
              </div>
            {% endif %}
          </div>
        </section>

      </div>

      <!-- ================= 6. INTERACTIVE KANTIPUR POLL & MULTIMEDIA SECTION ================= -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start pt-6 border-t border-neutral-200 dark:border-neutral-800">
        
        <!-- Interactive Poll (HTMX post voting) - 7 cols -->
        <div class="lg:col-span-7">
          <div id="kantipur-poll" class="bg-gradient-to-br from-neutral-50 to-neutral-100 dark:from-neutral-900 dark:to-neutral-850 p-6 sm:p-8 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-red-600 bg-red-50 dark:bg-red-950/50 px-2.5 py-1 rounded-md border border-red-200 dark:border-red-900/50">
                📊 कान्तिपुर जनमत (Interactive Poll)
              </span>
              <span class="text-xs text-neutral-500">
                कुल मत: <strong>{{ poll.total_votes }}</strong>
              </span>
            </div>
            
            <h3 class="text-lg md:text-xl font-bold text-neutral-900 dark:text-neutral-100 mb-6 font-serif leading-snug">
              {{ poll.question }}
            </h3>

            <!-- HTMX Vote Form -->
            <form 
              hx-post="/api/poll" 
              hx-target="#kantipur-poll" 
              hx-swap="outerHTML"
              class="space-y-3"
            >
              {% for opt in poll.options %}
                <label class="flex items-center justify-between p-3.5 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 cursor-pointer hover:border-red-500 dark:hover:border-red-500 transition-all group">
                  <div class="flex items-center gap-3">
                    <input 
                      type="radio" 
                      name="option" 
                      value="{{ opt.id }}" 
                      required
                      class="text-red-600 focus:ring-red-500 h-4 w-4 border-neutral-300"
                    />
                    <span class="text-sm font-semibold text-neutral-800 dark:text-neutral-200 group-hover:text-red-600 dark:group-hover:text-red-400">
                      {{ opt.text }}
                    </span>
                  </div>
                  <span class="text-xs text-neutral-400">{{ opt.percentage }}%</span>
                </label>
              {% endfor %}

              <div class="pt-4 flex items-center justify-between">
                <button 
                  type="submit"
                  class="px-6 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs uppercase tracking-wider transition-colors shadow-sm active:scale-95"
                >
                  मतदान गर्नुहोस् (Vote Now)
                </button>
                <span class="text-xs text-neutral-400 italic">
                  * HTMX मार्फत तत्काल नतिजा अद्यावधिक हुन्छ ।
                </span>
              </div>
            </form>

          </div>
        </div>

        <!-- Forex & Bullion Rates (5 cols) -->
        <div class="lg:col-span-5 bg-white dark:bg-neutral-900 p-6 sm:p-8 rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-sm space-y-6">
          <div class="flex items-center justify-between border-b border-neutral-100 dark:border-neutral-800 pb-4">
            <h3 class="font-serif font-bold text-base text-neutral-900 dark:text-neutral-100 flex items-center gap-2">
              💰 बजार भाउ र विदेशी विनिमय दर
            </h3>
            <span class="text-[11px] text-neutral-400">नेपाल राष्ट्र बैंक</span>
          </div>

          <!-- Gold / Silver -->
          <div class="grid grid-cols-2 gap-4">
            <div class="p-3 bg-amber-50/60 dark:bg-amber-950/20 rounded-xl border border-amber-200/50 dark:border-amber-900/30">
              <div class="text-[11px] text-amber-800 dark:text-amber-400 font-semibold">छापावाल सुन (तोला)</div>
              <div class="text-lg font-bold text-neutral-900 dark:text-neutral-100 mt-1">रु १,६०,५००</div>
              <div class="text-[10px] text-emerald-600 mt-0.5">▲ +रु ५००</div>
            </div>
            <div class="p-3 bg-neutral-50 dark:bg-neutral-800 rounded-xl border border-neutral-200 dark:border-neutral-700">
              <div class="text-[11px] text-neutral-600 dark:text-neutral-400 font-semibold">चाँदी (तोला)</div>
              <div class="text-lg font-bold text-neutral-900 dark:text-neutral-100 mt-1">रु १,९८०</div>
              <div class="text-[10px] text-red-500 mt-0.5">▼ -रु १०</div>
            </div>
          </div>

          <!-- Forex Exchange Rates Table -->
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
